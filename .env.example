# Copy this file to .env only if `uv run kit setup` cannot read your typing.
# setup writes the same five values for you.

# Langfuse key pair the app traces with
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Second Langfuse key pair, used by your coding agent to install evaluators
LANGFUSE_AGENT_PUBLIC_KEY=pk-lf-...
LANGFUSE_AGENT_SECRET_KEY=sk-lf-...

# Workshop LLM key from the 1Password link
WORKSHOP_LLM_KEY=sk-ant-...
